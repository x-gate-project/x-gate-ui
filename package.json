{
  "name": "usdtx-ui",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "18"
  },
  "scripts": {
    "init": "npm i && node -e \"require('fs').copyFileSync('./.env.local.example', './.env.local')\"",
    "clean": "rimraf .next out",
    "pack": "rimraf out && mkdirp out && zip out/deploy.zip -r .next package.json package-lock.json .npmrc .env.local public next-i18next.config.js next.config.js",
    "dev": "node server.js | pino-pretty",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "deploy": "vercel --prod",
    "format": "prettier --write \"(pages|src)/**/*.(ts|tsx)\"",
    "check-types": "tsc --noEmit --incremental false",
    "lint": "eslint \"{pages,src}/**/*.{ts,tsx}\" --fix"
  },
  "dependencies": {
    "@apollo/client": "^3.7.1",
    "@emotion/react": "^11.9.0",
    "@emotion/server": "^11.4.0",
    "@emotion/styled": "^11.8.1",
    "@gu-corp/env-loader": "^0.0.1-build.2",
    "@gu-corp/gu-wallet-sdk": "^1.0.0-build.12",
    "@gu-corp/redux-async-lib": "^1.0.2",
    "@gusdk/gu-wallet-connector": "^0.9.25-build.1",
    "@gusdk/react-nft-viewer-basic": "^0.9.4-build.0",
    "@metamask/metamask-eth-abis": "^3.1.1",
    "@mui/icons-material": "^5.6.0",
    "@mui/lab": "^5.0.0-alpha.76",
    "@mui/material": "^5.6.0",
    "class-validator": "^0.13.2",
    "cross-env": "^7.0.3",
    "dompurify": "^3.2.3",
    "ethereumjs-util": "^7.1.3",
    "ethers": "^6.13.2",
    "formik": "^2.2.6",
    "moment": "^2.29.1",
    "moment-duration-format": "^2.3.2",
    "moment-timezone": "^0.5.33",
    "mongoose": "^6.6.0",
    "next": "^12.0.10",
    "next-i18next": "^8.1.2",
    "nookies": "^2.5.2",
    "notistack": "^2.0.3",
    "nprogress": "^0.2.0",
    "pino": "^8.6.0",
    "qrcode": "^1.5.1",
    "react": "17.0.2",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "17.0.2",
    "react-jazzicon": "^1.0.4",
    "react-joyride": "^2.4.0",
    "react-redux": "^7.2.3",
    "redux": "^4.0.5",
    "redux-devtools-extension": "^2.13.9",
    "redux-promise": "^0.6.0",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.49.7",
    "tss-react": "^4.3.4",
    "use-debounce": "^7.0.1",
    "validator": "^13.7.0",
    "web3": "^1.6.0",
    "yup": "^0.32.9"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.14.2",
    "@gusdk/uploader-basic": "^1.0.0",
    "@shelf/jest-mongodb": "^3.0.2",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^28.1.8",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/moment-duration-format": "^2.2.3",
    "@types/node": "^14.14.32",
    "@types/nprogress": "^0.2.0",
    "@types/react": "^17.0.3",
    "@types/react-copy-to-clipboard": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "babel-jest": "^28.1.3",
    "dotenv": "^16.0.2",
    "eslint": "^7.27.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "pino-pretty": "^9.1.0",
    "prettier": "^2.3.0",
    "react-test-renderer": "^17.0.2",
    "supertest": "^6.2.4",
    "typescript": "^4.5.5"
  }
}
